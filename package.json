{
  "name": "canonote",
  "version": "1.0.0",
  "description": "A calm, local-first markdown notebook your agent can write into — agent edits arrive as reviewable suggestions, never silent rewrites.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/yardworkdev/canonote.git" },
  "homepage": "https://canonote.vercel.app",
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "audit:artifact": "node scripts/audit-artifact.mjs",
    "build": "vite build && node scripts/build-sw.mjs",
    "build:rust": "cargo build --release --manifest-path rust/canonote-agent/Cargo.toml",
    "check:agent-write": "node scripts/live-agent-write.mjs",
    "check:all": "node scripts/check-all.mjs",
    "check:attribution": "node scripts/live-attribution-proof.mjs",
    "check:band-scroll": "node scripts/check-band-scroll.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:collab": "node scripts/live-collab-proof.mjs",
    "check:conflict": "node scripts/live-conflict.mjs",
    "check:eye": "node scripts/live-eye-click.mjs",
    "check:first-note": "node scripts/live-first-note.mjs",
    "check:hung-save": "node scripts/live-hung-save.mjs",
    "check:live": "node scripts/live-check.mjs",
    "check:live-app": "node scripts/check-live-app.mjs",
    "check:new-note": "node scripts/live-new-note-race.mjs",
    "check:offline": "node scripts/check-offline.mjs",
    "check:plus-focus": "node scripts/live-plus-focus.mjs",
    "check:powers": "node scripts/live-agent-powers.mjs",
    "check:presence": "node scripts/check-presence.mjs",
    "check:presence-shared": "node scripts/check-presence-shared.mjs",
    "check:portable": "node scripts/check-portable.mjs",
    "check:slow-load": "node scripts/live-slow-load.mjs",
    "check:thread": "node scripts/live-thread.mjs",
    "check:thread-store": "node scripts/check-thread-store.mjs",
    "check:no-clobber": "node scripts/live-no-clobber.mjs",
    "check:live-collab": "node scripts/check-live-collab.mjs",
    "check:caret-up": "node scripts/check-caret-up.mjs",
    "check:token-used": "node scripts/live-token-last-used.mjs",
    "check:url-token": "node scripts/live-url-token.mjs",
    "check:ux": "node scripts/live-ux-check.mjs",
    "conformance": "node scripts/conformance.mjs",
    "contract": "node scripts/contract.mjs",
    "deploy": "node scripts/deploy.mjs",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "og": "node scripts/og.mjs",
    "preview": "vite preview",
    "shots": "node scripts/screenshots.mjs",
    "start": "vite",
    "test": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "typecheck": "tsc -p tsconfig.api.json",
    "verify": "npm run typecheck && npm run test:unit && npm run build",
    "check:offline-live": "node scripts/check-offline-live.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "dompurify": "^3.4.11",
    "jszip": "^3.10.1",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.4.14",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.24",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.3.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  }
}
